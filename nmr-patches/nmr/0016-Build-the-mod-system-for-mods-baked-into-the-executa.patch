 }
+#else // RECOMP_STATIC_MODS
+
+// ---- Baked mods (static_mods.h): code built into the executable, and the base
+// functions instrumented for them. Replacements and hooks take effect through
+// the dispatch slot checked at the instrumented function's entry.
+
+namespace {
+    std::unordered_map<std::string, const recomp_static_mod*> static_mods_by_id;
+
+    struct StaticDispatchSlot {
+        recomp_func_t* original = nullptr;
+        recomp_func_t* replacement = nullptr;
+        size_t entry_hook = (size_t)-1;
+        size_t return_hook = (size_t)-1;
+        bool bypass = false;
+    };
+    const recomp_static_dispatch_entry* static_dispatch_entries = nullptr;
+    unsigned char* static_dispatch_active = nullptr;
+    std::vector<StaticDispatchSlot> static_dispatch_slots;
+
+    // The slot of an instrumented base function, now active, or null if the
+    // build did not instrument that function.
+    StaticDispatchSlot* claim_static_dispatch_slot(uint32_t section_rom, uint32_t vram) {
+        for (size_t i = 0; i < static_dispatch_slots.size(); i++) {
+            if (static_dispatch_entries[i].section_rom != section_rom || static_dispatch_entries[i].function_vram != vram) {
+                continue;
+            }
+            StaticDispatchSlot& slot = static_dispatch_slots[i];
+            if (slot.original == nullptr) {
+                slot.original = recomp::overlays::get_func_by_section_rom_function_vram(section_rom, vram);
+                if (slot.original == nullptr) {
+                    return nullptr;
+                }
+            }
+            static_dispatch_active[i] = 1;
+            return &slot;
+        }
+        return nullptr;
+    }
+
+    void reset_static_dispatch() {
+        for (size_t i = 0; i < static_dispatch_slots.size(); i++) {
+            static_dispatch_active[i] = 0;
+        }
+        static_dispatch_slots.assign(static_dispatch_slots.size(), StaticDispatchSlot{});
+    }
+}
+
+void recomp::mods::register_static_mod(const recomp_static_mod* mod) {
+    static_mods_by_id[mod->mod_id] = mod;
+}
+
+void recomp::mods::register_static_dispatch(const recomp_static_dispatch_entry* entries, size_t count, unsigned char* active) {
+    static_dispatch_entries = entries;
+    static_dispatch_active = active;
+    static_dispatch_slots.assign(count, StaticDispatchSlot{});
+}
+
+extern "C" int recomp_static_dispatch(uint8_t* rdram, recomp_context* ctx, uint32_t slot_index) {
+    StaticDispatchSlot& slot = static_dispatch_slots[slot_index];
+    // The original re-entered from below: let its body run.
+    if (slot.bypass) {
+        slot.bypass = false;
+        return 0;
+    }
+    if (slot.entry_hook != (size_t)-1) {
+        recomp::mods::run_hook(rdram, ctx, slot.entry_hook);
+    }
+    if (slot.replacement != nullptr) {
+        slot.replacement(rdram, ctx);
+    }
+    else {
+        slot.bypass = true;
+        slot.original(rdram, ctx);
+        slot.bypass = false;
+    }
+    if (slot.return_hook != (size_t)-1) {
+        recomp::mods::run_hook(rdram, ctx, slot.return_hook);
+    }
+    return 1;
+}
+
+recomp::mods::StaticCodeHandle::StaticCodeHandle(const recomp_static_mod* mod, const N64Recomp::Context& context, const ModCodeHandleInputs& inputs) : mod(mod) {
+    // The layout must match the mod file's (a different build of the mod would not).
+    is_good = mod->num_functions == context.functions.size() && mod->num_imports == context.import_symbols.size() &&
+              mod->num_sections == context.sections.size();
+    if (is_good) {
+        *mod->base_event_index = inputs.base_event_index;
+    }
+}
+
+void recomp::mods::StaticCodeHandle::set_imported_function(size_t import_index, GenericFunction func) {
+    std::visit(overloaded {
+        [this, import_index](recomp_func_t* native_func) {
+            mod->imported_funcs[import_index] = native_func;
+        }
+    }, func);
+}
+
+recomp_func_t* recomp::mods::StaticCodeHandle::bind_ext_import(size_t import_index, recomp_func_ext_t* func, uintptr_t arg) {
+    mod->ext_imports[import_index] = recomp_static_mod_ext_import{ func, arg };
+    return mod->ext_import_shims[import_index];
+}
+
+recomp::mods::CodeModLoadError recomp::mods::StaticCodeHandle::populate_reference_symbols(const N64Recomp::Context& context, std::string& error_param) {
+    size_t reference_symbol_index = 0;
+    for (const auto& section : context.sections) {
+        for (const auto& reloc : section.relocs) {
+            if (reloc.type == N64Recomp::RelocType::R_MIPS_26 && reloc.reference_symbol && context.is_regular_reference_section(reloc.target_section)) {
+                recomp_func_t* cur_func = recomp::overlays::get_func_by_section_index_function_offset(reloc.target_section, reloc.target_section_offset);
+                if (cur_func == nullptr || reference_symbol_index >= mod->num_reference_symbols) {
+                    std::stringstream error_param_stream{};
+                    error_param_stream << std::hex <<
+                        "section: " << reloc.target_section <<
+                        " func offset: 0x" << reloc.target_section_offset;
+                    error_param = error_param_stream.str();
+                    return CodeModLoadError::InvalidReferenceSymbol;
+                }
+                mod->reference_symbol_funcs[reference_symbol_index] = cur_func;
+                reference_symbol_index++;
+            }
+        }
+    }
+    return CodeModLoadError::Good;
+}
+#endif // RECOMP_STATIC_MODS
 
