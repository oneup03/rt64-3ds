From e4928d1e8c92a9f061d7841c47cbb90e331bc9c8 Mon Sep 17 00:00:00 2001
From: oneup03 <oneup03@gmail.com>
Date: Sat, 26 Sep 2026 17:41:10 -0500
Subject: [PATCH] Add a portable 128-bit multiply for targets without __int128

32-bit ARM (the 3DS) has no __int128, so DMULT/DMULTU hit the #error.
Build the product from four 32x32->64 partial products instead, with
the two's-complement correction for the signed form. Checked against
__int128 on the host for the sign and overflow corner cases.
---
 include/recomp.h | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/include/recomp.h b/include/recomp.h
index 73f3e73..3f14575 100644
--- a/include/recomp.h
+++ b/include/recomp.h
@@ -67,7 +67,33 @@ static inline void DMULTU(uint64_t a, uint64_t b, uint64_t* lo64, uint64_t* hi64
 }
 
 #else
-#error "128-bit integer type not found"
+
+// No native 128-bit integer (32-bit targets such as the 3DS's ARM11): build the
+// 128-bit product from four 32x32->64 partial products.
+static inline void DMULTU(uint64_t a, uint64_t b, uint64_t* lo64, uint64_t* hi64) {
+    uint64_t a_lo = (uint32_t)a, a_hi = a >> 32;
+    uint64_t b_lo = (uint32_t)b, b_hi = b >> 32;
+    uint64_t p0 = a_lo * b_lo;
+    uint64_t p1 = a_lo * b_hi;
+    uint64_t p2 = a_hi * b_lo;
+    uint64_t p3 = a_hi * b_hi;
+    uint64_t mid = (p0 >> 32) + (uint32_t)p1 + (uint32_t)p2;
+
+    *lo64 = (mid << 32) | (uint32_t)p0;
+    *hi64 = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32);
+}
+
+static inline void DMULT(int64_t a, int64_t b, int64_t* lo64, int64_t* hi64) {
+    // Two's complement: a = a_u - 2^64*[a<0], so the signed high word is the
+    // unsigned high word minus b_u when a is negative, and minus a_u when b is.
+    uint64_t lo, hi;
+    DMULTU((uint64_t)a, (uint64_t)b, &lo, &hi);
+    if (a < 0) hi -= (uint64_t)b;
+    if (b < 0) hi -= (uint64_t)a;
+    *lo64 = (int64_t)lo;
+    *hi64 = (int64_t)hi;
+}
+
 #endif
 
 static inline void DDIV(int64_t a, int64_t b, int64_t* quot, int64_t* rem) {
-- 
