+bool N64Recomp::traces_function(const Context& context, size_t func_index) {
+    if (!context.trace_mode) {
+        return false;
+    }
+    if (!context.trace_skip_simple_leaves) {
+        return true;
+    }
+    const Function& func = context.functions[func_index];
+    if (func.stubbed || !func.function_hooks.empty()) {
+        return true;
+    }
+    // A call (jal, jalr, a linking branch), a tail call (a jump out of the
+    // function), a loop (a branch to itself or back) or a jr that isn't a
+    // return (a jump table) keeps the trace.
+    const uint32_t vram_end = func.vram + (uint32_t)func.words.size() * 4;
+    uint32_t vram = func.vram;
+    for (uint32_t word : func.words) {
+        rabbitizer::InstructionCpu instr(byteswap(word), vram);
+        if (instr.doesLink()) {
+            return true;
+        }
+        if (instr.getUniqueId() == rabbitizer::InstrId::UniqueId::cpu_jr && instr.GetO32_rs() != rabbitizer::Registers::Cpu::GprO32::GPR_O32_ra) {
+            return true;
+        }
+        if (instr.isBranch() || instr.getUniqueId() == rabbitizer::InstrId::UniqueId::cpu_j) {
+            const uint32_t target = (uint32_t)instr.getBranchVramGeneric();
+            if (target <= vram || target >= vram_end) {
+                return true;
+            }
+        }
+        vram += 4;
+    }
+    return false;
+}
